# Configuración de finance-tracker. Copia este archivo a .env y ajusta lo que
# necesites: todos los valores tienen default, así que .env puede quedar vacío.
# Cada variable corresponde a un campo de app/config.py.

# ── General ───────────────────────────────────────────────────────────
APP_NAME="Tracker de Patrimonio"
# Zona horaria de los jobs programados (resumen diario, snapshot, backup)
TIMEZONE=Europe/Madrid

# Puerto publicado en el host. Solo lo lee docker-compose.yml, no la app.
FINANCE_PORT=8001

# Interfaz en la que se publica el puerto. Por defecto 127.0.0.1: la app solo
# se alcanza desde la propia máquina. Para usarla desde el móvil en la LAN pon
# 0.0.0.0 AQUÍ Y ACTIVA ENABLE_AUTH abajo: sin eso, cualquiera en la misma red
# -un invitado, un dispositivo IoT comprometido- lee y edita el patrimonio.
FINANCE_BIND=127.0.0.1

# ── Autenticación HTTP Basic ──────────────────────────────────────────
# Desactivada por defecto (pensada para uso local). ACTÍVALA si expones la app
# fuera de localhost, aunque sea por VPN, y cambia la contraseña.
#
# Con ENABLE_AUTH=true la app NO arranca si AUTH_PASSWORD sigue siendo
# "changeme" o tiene menos de 8 caracteres: un fallo ruidoso al arrancar se
# corrige en un minuto, una app expuesta con la contraseña de fábrica puede
# pasar meses sin que nadie lo note.
ENABLE_AUTH=false
AUTH_USERNAME=admin
AUTH_PASSWORD=changeme

# ── Base de datos ─────────────────────────────────────────────────────
# Solo hace falta fuera de Docker (p. ej. ./finance.db para correr en local):
# docker-compose.yml ya la fija al volumen persistente y tiene prioridad sobre
# este archivo, así que ahí este valor se ignora.
DB_PATH=/data/finance.db

# Moneda base de todos los totales consolidados. Transaction.amount se guarda
# SIEMPRE en esta divisa; los importes en otras se convierten al registrarlos.
BASE_CURRENCY=EUR

# Marca las cookies (CSRF y avisos) como Secure. Actívalo SOLO si sirves la app
# por HTTPS, detrás de un proxy inverso con TLS.
#
# Con HTTP el navegador descarta una cookie Secure, así que el token de CSRF no
# vuelve nunca y TODOS los formularios empiezan a dar 403 sin explicar por qué.
COOKIES_SEGURAS=false

# ── Diagnóstico ───────────────────────────────────────────────────────
# Cuenta las sentencias SQL de cada petición y las publica en la cabecera
# X-Consultas-SQL. Solo para investigar por qué una página va lenta; con esto
# apagado no hay ni listener registrado, así que no cuesta nada.
DEBUG_SQL=false

# ── Precios y muestreo ────────────────────────────────────────────────
# Cada cuántos minutos se refrescan los precios de acciones/cripto
PRICE_REFRESH_MINUTES=60
# Muestreo intradía del patrimonio (curva 1D del dashboard) y su retención.
# La curva solo cambia cuando cambian los precios, así que no tiene sentido
# muestrear mucho más fino que PRICE_REFRESH_MINUTES.
INTRADAY_SAMPLE_MINUTES=15
INTRADAY_RETENTION_HOURS=48

# ── Backups ───────────────────────────────────────────────────────────
# Copias diarias de la BD en <dir de DB_PATH>/backups; se conservan N
BACKUP_KEEP=14

# ── Presupuestos ──────────────────────────────────────────────────────
BUDGETS_ENABLED=true

# ── Umbrales del análisis X-Ray ───────────────────────────────────────
# % máximo que puede pesar un activo sobre la cartera invertida
XRAY_MAX_ASSET_PCT=25.0
# % máximo en divisas distintas de la base
XRAY_MAX_CURRENCY_PCT=50.0
# Días sin precio de mercado antes de avisar de precio estancado
XRAY_STALE_PRICE_DAYS=7
# Días sin revisar un valor manual antes de avisar
XRAY_STALE_MANUAL_DAYS=120

# ── Bot de Telegram (opcional) ────────────────────────────────────────
# Sin token el bot no arranca. Créalo con @BotFather y pega el token aquí;
# después escríbele por Telegram y él te dirá tu chat_id para rellenar el resto.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Hora local (TIMEZONE) del resumen diario de cartera
TELEGRAM_SUMMARY_HOUR=9
TELEGRAM_SUMMARY_MINUTE=0
# Modelo de faster-whisper para transcribir notas de voz: tiny/base/small/medium
# (a más grande, mejor transcripción y más CPU)
WHISPER_MODEL=small
